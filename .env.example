# ====================================================================
# RELELAPOS CLOUD ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your Supabase credentials
# Also set these in Vercel: Project Settings -> Environment Variables
# ====================================================================

# Supabase Project URL (Dashboard -> Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key (Dashboard -> Project Settings -> API -> Project API Keys -> anon / public)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Dashboard -> Project Settings -> API -> Project API Keys -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
